# Session pooler, port 5432. Render is IPv4-only; the direct database host is not.
# User is bot_worker.<project-ref>, not postgres.
DATABASE_URL=postgresql://bot_worker.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# https://docs.x.ai — the worker refuses to start until this is set.
XAI_API_KEY=

# Optional. Defaults to grok-4.7.
XAI_MODEL=grok-4.7
