# Session pooler, port 5432. The direct database host is IPv6-only.
# User is bot_worker.<project-ref>, not postgres.
DATABASE_URL=postgresql://bot_worker.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Set this on the Scaleway container. The worker refuses to start until it is set.
# The Scaleway API key stays out of this file: it is only for docker push.
MISTRAL_API_KEY=

# Cheap model used for tests. Override on the container when you want a larger one.
MISTRAL_MODEL=mistral-medium-latest
